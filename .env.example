# --- Database ---
POSTGRES_USER=egomot
POSTGRES_PASSWORD=egomot_dev_password
POSTGRES_DB=egomot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://egomot:egomot_dev_password@localhost:5432/egomot?schema=public

# --- API ---
API_PORT=3000
NODE_ENV=development

# JWT (Module 0.2 — Auth)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=12h

# Product photos (§12-Б.1). The files live here, not in the database, so
# this directory needs its own backup alongside the database dump.
UPLOAD_DIR=./var/uploads

# --- Web ---
WEB_PORT=5173
VITE_API_URL=http://localhost:3000

# --- Bootstrap seed (Module 0.2) ---
# The first OWNER. Without it nobody can log in, since user administration is
# OWNER-only. The seed is idempotent and skips once any OWNER exists.
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_PHONE=0700000000
BOOTSTRAP_OWNER_PASSWORD=change_me_at_once
BOOTSTRAP_OWNER_PIN=1234

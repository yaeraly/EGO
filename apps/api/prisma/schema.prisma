generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account_movements {
  id               BigInt           @id @default(autoincrement())
  account_id       String           @db.Uuid
  document_id      String           @db.Uuid
  amount           Decimal          @db.Decimal(14, 2)
  kgs_value        Decimal?         @db.Decimal(14, 2)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  payment_accounts payment_accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents        documents        @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "idx_acc_mov_account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model account_transfers {
  document_id                                                       String           @id @db.Uuid
  from_account                                                      String           @db.Uuid
  to_account                                                        String           @db.Uuid
  amount                                                            Decimal          @db.Decimal(14, 2)
  documents                                                         documents        @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_accounts_account_transfers_from_accountTopayment_accounts payment_accounts @relation("account_transfers_from_accountTopayment_accounts", fields: [from_account], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_accounts_account_transfers_to_accountTopayment_accounts   payment_accounts @relation("account_transfers_to_accountTopayment_accounts", fields: [to_account], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model advance_refund_lines {
  id                     BigInt            @id @default(autoincrement())
  advance_id             String            @db.Uuid
  account_id             String?           @db.Uuid
  sale_id                String?           @db.Uuid
  amount                 Decimal           @db.Decimal(14, 2)
  source_override_reason String?
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  payment_accounts       payment_accounts? @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  advances               advances          @relation(fields: [advance_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  sales                  sales?            @relation(fields: [sale_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model advances {
  document_id                                   String                 @id @db.Uuid
  customer_id                                   String                 @db.Uuid
  reservation_id                                String?                @db.Uuid
  from_payment_id                               String?                @db.Uuid
  account_id                                    String                 @db.Uuid
  amount                                        Decimal                @db.Decimal(14, 2)
  astatus                                       advance_status         @default(ACTIVE)
  applied_amount                                Decimal                @default(0) @db.Decimal(14, 2)
  refunded_amount                               Decimal                @default(0) @db.Decimal(14, 2)
  advance_refund_lines                          advance_refund_lines[]
  payment_accounts                              payment_accounts       @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                                     customers              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents_advances_document_idTodocuments     documents              @relation("advances_document_idTodocuments", fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents_advances_from_payment_idTodocuments documents?             @relation("advances_from_payment_idTodocuments", fields: [from_payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservations                                  reservations?          @relation(fields: [reservation_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

model audit_log {
  id          BigInt     @id @default(autoincrement())
  user_id     String?    @db.Uuid
  document_id String?    @db.Uuid
  entity      String
  entity_id   String?
  action      String
  old_value   Json?
  new_value   Json?
  reason      String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  documents   documents? @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity, entity_id], map: "idx_audit_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bonus_payments {
  document_id      String           @id @db.Uuid
  employee_id      String           @db.Uuid
  account_id       String           @db.Uuid
  amount           Decimal          @db.Decimal(14, 2)
  payment_accounts payment_accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents        documents        @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users            @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bonuses {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id           String       @unique @db.Uuid
  employee_id       String       @db.Uuid
  revenue           Decimal      @db.Decimal(14, 2)
  fifo_cogs         Decimal      @db.Decimal(14, 2)
  bonus_base        Decimal      @db.Decimal(14, 2)
  bonus_rate        Decimal      @db.Decimal(5, 2)
  calculated_amount Decimal      @db.Decimal(14, 2)
  adjustment_amount Decimal      @default(0) @db.Decimal(14, 2)
  payable_amount    Decimal      @db.Decimal(14, 2)
  bstatus           bonus_status @default(CALCULATED)
  calculated_at     DateTime     @default(now()) @db.Timestamptz(6)
  payable_at        DateTime?    @db.Timestamptz(6)
  paid_at           DateTime?    @db.Timestamptz(6)
  payment_doc       String?      @db.Uuid
  users             users        @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents         documents?   @relation(fields: [payment_doc], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales             sales        @relation(fields: [sale_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

model business_days {
  business_date        DateTime               @id @db.Date
  status               day_status             @default(OPEN)
  closed_by            String?                @db.Uuid
  closed_at            DateTime?              @db.Timestamptz(6)
  users                users?                 @relation(fields: [closed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  daily_cash_handovers daily_cash_handovers[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model business_months {
  year          Int
  month         Int
  status        month_status @default(OPEN)
  closed_by     String?      @db.Uuid
  closed_at     DateTime?    @db.Timestamptz(6)
  reopen_reason String?
  users         users?       @relation(fields: [closed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([year, month])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capital_docs {
  document_id      String           @id @db.Uuid
  source           capital_source
  investor_id      String?          @db.Uuid
  account_id       String           @db.Uuid
  amount           Decimal          @db.Decimal(14, 2)
  currency         currency_code    @default(KGS)
  rate             Decimal?         @db.Decimal(12, 6)
  payment_accounts payment_accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents        documents        @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  investors        investors?       @relation(fields: [investor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cargo_companies {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  is_active      Boolean          @default(true)
  cargo_ledger   cargo_ledger[]
  cargo_payments cargo_payments[]
  claims         claims[]
  purchases      purchases[]
}

model cargo_ledger {
  id               BigInt          @id @default(autoincrement())
  cargo_company_id String          @db.Uuid
  document_id      String          @db.Uuid
  entry_type       String
  amount_usd       Decimal         @db.Decimal(14, 2)
  kgs_value        Decimal?        @db.Decimal(14, 2)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  cargo_companies  cargo_companies @relation(fields: [cargo_company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents        documents       @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cargo_payments {
  document_id      String           @id @db.Uuid
  cargo_company_id String           @db.Uuid
  from_account     String           @db.Uuid
  amount           Decimal          @db.Decimal(14, 2)
  currency         currency_code
  rate             Decimal?         @db.Decimal(12, 6)
  kgs_value        Decimal          @db.Decimal(14, 2)
  fx_gain_loss_kgs Decimal          @default(0) @db.Decimal(14, 2)
  cargo_companies  cargo_companies  @relation(fields: [cargo_company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents        documents        @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_accounts payment_accounts @relation(fields: [from_account], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model claim_compensations {
  id         BigInt    @id @default(autoincrement())
  claim_id   String    @db.Uuid
  receipt_id String?   @db.Uuid
  amount     Decimal   @db.Decimal(14, 2)
  comment    String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  claims     claims    @relation(fields: [claim_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  receipts   receipts? @relation(fields: [receipt_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model claims {
  document_id         String                @id @db.Uuid
  ctype               claim_type
  discrepancy_id      String?               @db.Uuid
  supplier_id         String?               @db.Uuid
  cargo_company_id    String?               @db.Uuid
  amount              Decimal               @db.Decimal(14, 2)
  currency            currency_code
  cstatus             claim_status          @default(OPEN)
  writeoff_reason     String?
  claim_compensations claim_compensations[]
  cargo_companies     cargo_companies?      @relation(fields: [cargo_company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discrepancies       discrepancies?        @relation(fields: [discrepancy_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  documents           documents             @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers           suppliers?            @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model corrections {
  document_id                                           String    @id @db.Uuid
  original_document_id                                  String    @db.Uuid
  correction_type                                       String
  reason                                                String
  old_value                                             Json
  new_value                                             Json
  effective_date                                        DateTime  @db.Date
  documents_corrections_document_idTodocuments          documents @relation("corrections_document_idTodocuments", fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents_corrections_original_document_idTodocuments documents @relation("corrections_original_document_idTodocuments", fields: [original_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model credit_overrides {
  id             BigInt     @id @default(autoincrement())
  customer_id    String     @db.Uuid
  sale_id        String?    @db.Uuid
  reservation_id String?    @db.Uuid
  owner_id       String     @db.Uuid
  reason         String
  open_debt      Decimal    @db.Decimal(14, 2)
  overdue_amount Decimal    @db.Decimal(14, 2)
  credit_limit   Decimal    @db.Decimal(14, 2)
  new_debt       Decimal    @db.Decimal(14, 2)
  projected_debt Decimal    @db.Decimal(14, 2)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  customers      customers  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users      @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents      documents? @relation(fields: [reservation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales          sales?     @relation(fields: [sale_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model currency_exchanges {
  document_id                                                        String           @id @db.Uuid
  from_account                                                       String           @db.Uuid
  to_account                                                         String           @db.Uuid
  given_amount                                                       Decimal          @db.Decimal(14, 2)
  received_amount                                                    Decimal          @db.Decimal(14, 2)
  rate                                                               Decimal          @db.Decimal(12, 6)
  commission                                                         Decimal          @default(0) @db.Decimal(14, 2)
  intermediary                                                       String?
  fx_gain_loss_kgs                                                   Decimal?         @db.Decimal(14, 2)
  documents                                                          documents        @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_accounts_currency_exchanges_from_accountTopayment_accounts payment_accounts @relation("currency_exchanges_from_accountTopayment_accounts", fields: [from_account], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_accounts_currency_exchanges_to_accountTopayment_accounts   payment_accounts @relation("currency_exchanges_to_accountTopayment_accounts", fields: [to_account], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model currency_layer_consumptions {
  id              BigInt          @id @default(autoincrement())
  layer_id        String          @db.Uuid
  document_id     String          @db.Uuid
  amount          Decimal         @db.Decimal(14, 2)
  kgs_value       Decimal         @db.Decimal(14, 2)
  documents       documents       @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency_layers currency_layers @relation(fields: [layer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model currency_layers {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id                  String                        @db.Uuid
  cex_document_id             String                        @db.Uuid
  original_amount             Decimal                       @db.Decimal(14, 2)
  remaining_amount            Decimal                       @db.Decimal(14, 2)
  rate_kgs                    Decimal                       @db.Decimal(12, 6)
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  currency_layer_consumptions currency_layer_consumptions[]
  payment_accounts            payment_accounts              @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents                   documents                     @relation(fields: [cex_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, created_at], map: "idx_curr_layers_fifo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_payment_lines {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id        String            @db.Uuid
  account_id        String            @db.Uuid
  amount            Decimal           @db.Decimal(14, 2)
  cash_given        Decimal?          @db.Decimal(14, 2)
  change_given      Decimal?          @db.Decimal(14, 2)
  payment_accounts  payment_accounts  @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_payments customer_payments @relation(fields: [payment_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_payments {
  document_id                                                String                   @id @db.Uuid
  customer_id                                                String                   @db.Uuid
  total_amount                                               Decimal                  @db.Decimal(14, 2)
  overpay_advance_doc                                        String?                  @db.Uuid
  customer_payment_lines                                     customer_payment_lines[]
  customers                                                  customers                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents_customer_payments_document_idTodocuments         documents                @relation("customer_payments_document_idTodocuments", fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents_customer_payments_overpay_advance_docTodocuments documents?               @relation("customer_payments_overpay_advance_docTodocuments", fields: [overpay_advance_doc], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_allocations                                        payment_allocations[]
}

model customers {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  is_walk_in               Boolean             @default(false)
  name                     String
  phone                    String?
  ctype                    customer_type       @default(RETAIL)
  category                 customer_category   @default(STANDARD)
  category_manual_override Boolean             @default(false)
  individual_credit_limit  Decimal?            @db.Decimal(14, 2)
  is_active                Boolean             @default(true)
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  advances                 advances[]
  credit_overrides         credit_overrides[]
  customer_payments        customer_payments[]
  reservations             reservations[]
  returns                  returns[]
  sales                    sales[]

  @@index([phone], map: "idx_customers_phone")
}

model daily_cash_handovers {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_date     DateTime      @db.Date
  user_id           String        @db.Uuid
  expected_amount   Decimal       @db.Decimal(14, 2)
  actual_amount     Decimal       @db.Decimal(14, 2)
  difference        Decimal       @db.Decimal(14, 2)
  difference_reason String?
  transfer_doc_id   String?       @db.Uuid
  handed_at         DateTime      @default(now()) @db.Timestamptz(6)
  business_days     business_days @relation(fields: [business_date], references: [business_date], onDelete: NoAction, onUpdate: NoAction)
  documents         documents?    @relation(fields: [transfer_doc_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([business_date, user_id])
}

model defect_acts {
  document_id    String         @id @db.Uuid
  return_id      String?        @db.Uuid
  discrepancy_id String?        @db.Uuid
  product_id     String         @db.Uuid
  qty            Decimal        @db.Decimal(12, 2)
  reason         String
  decision       String?
  checked_by     String?        @db.Uuid
  users          users?         @relation(fields: [checked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discrepancies  discrepancies? @relation(fields: [discrepancy_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  documents      documents      @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products       products       @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returns        returns?       @relation(fields: [return_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

model discrepancies {
  document_id        String             @id @db.Uuid
  receipt_id         String             @db.Uuid
  purchase_id        String             @db.Uuid
  product_id         String             @db.Uuid
  ordered_qty        Decimal            @db.Decimal(12, 2)
  received_qty       Decimal            @db.Decimal(12, 2)
  diff_qty           Decimal            @db.Decimal(12, 2)
  dtype              discrepancy_type
  dstatus            discrepancy_status @default(OPEN)
  financial_decision String?
  claims             claims[]
  defect_acts        defect_acts[]
  documents          documents          @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products           products           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchases          purchases          @relation(fields: [purchase_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  receipts           receipts           @relation(fields: [receipt_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
}

model doc_sequences {
  doc_type    doc_type
  year        Int
  last_number Int      @default(0)

  @@id([doc_type, year])
}

model documents {
  id                                                                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type                                                           doc_type
  doc_number                                                         String                        @unique
  business_date                                                      DateTime                      @db.Date
  status                                                             doc_status                    @default(DRAFT)
  created_by                                                         String                        @db.Uuid
  confirmed_by                                                       String?                       @db.Uuid
  created_at                                                         DateTime                      @default(now()) @db.Timestamptz(6)
  confirmed_at                                                       DateTime?                     @db.Timestamptz(6)
  cancelled_at                                                       DateTime?                     @db.Timestamptz(6)
  comment                                                            String?
  account_movements                                                  account_movements[]
  account_transfers                                                  account_transfers?
  advances_advances_document_idTodocuments                           advances?                     @relation("advances_document_idTodocuments")
  advances_advances_from_payment_idTodocuments                       advances[]                    @relation("advances_from_payment_idTodocuments")
  audit_log                                                          audit_log[]
  bonus_payments                                                     bonus_payments?
  bonuses                                                            bonuses[]
  capital_docs                                                       capital_docs?
  cargo_ledger                                                       cargo_ledger[]
  cargo_payments                                                     cargo_payments?
  claims                                                             claims?
  corrections_corrections_document_idTodocuments                     corrections?                  @relation("corrections_document_idTodocuments")
  corrections_corrections_original_document_idTodocuments            corrections[]                 @relation("corrections_original_document_idTodocuments")
  credit_overrides                                                   credit_overrides[]
  currency_exchanges                                                 currency_exchanges?
  currency_layer_consumptions                                        currency_layer_consumptions[]
  currency_layers                                                    currency_layers[]
  customer_payments_customer_payments_document_idTodocuments         customer_payments?            @relation("customer_payments_document_idTodocuments")
  customer_payments_customer_payments_overpay_advance_docTodocuments customer_payments[]           @relation("customer_payments_overpay_advance_docTodocuments")
  daily_cash_handovers                                               daily_cash_handovers[]
  defect_acts                                                        defect_acts?
  discrepancies                                                      discrepancies?
  users_documents_confirmed_byTousers                                users?                        @relation("documents_confirmed_byTousers", fields: [confirmed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_documents_created_byTousers                                  users                         @relation("documents_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenses                                                           expenses?
  fifo_layers                                                        fifo_layers[]
  handover_acts                                                      handover_acts?
  inventories                                                        inventories?
  lots                                                               lots?
  other_income                                                       other_income?
  purchases                                                          purchases?
  receipts                                                           receipts?
  reservations                                                       reservations?
  returns                                                            returns?
  salary_payments                                                    salary_payments?
  sales_sales_document_idTodocuments                                 sales?                        @relation("sales_document_idTodocuments")
  sales_sales_from_reservationTodocuments                            sales[]                       @relation("sales_from_reservationTodocuments")
  stock_movements                                                    stock_movements[]
  supplier_ledger                                                    supplier_ledger[]
  supplier_payments                                                  supplier_payments?

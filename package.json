{
  "name": "egomot",
  "version": "0.1.0",
  "private": true,
  "description": "EGOMOT — business management system",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @egomot/api",
    "dev:web": "npm run dev --workspace @egomot/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "doctor": "scripts/doctor.sh",
    "db:generate": "scripts/prisma.sh generate",
    "db:deploy": "scripts/prisma.sh migrate deploy",
    "db:migrate": "scripts/prisma.sh migrate dev",
    "db:pull": "scripts/prisma.sh db pull",
    "db:seed": "scripts/prisma.sh seed",
    "db:verify": "scripts/verify-schema-parity.sh",
    "setup": "npm run db:deploy && npm run db:generate && npm run db:seed && npm run build"
  }
}
